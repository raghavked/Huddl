# Copy to mobile/.env — same Supabase project as the web app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# The web app's origin. Password-reset emails from the phone land on the web
# reset page, so this is where that link points. Defaults to https://huddl.app
# when unset; set it to a laptop origin (e.g. http://192.168.x.x:3000) to test
# the reset round-trip against a dev web server.
EXPO_PUBLIC_WEB_URL=https://huddl.app

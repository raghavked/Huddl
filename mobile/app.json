{
  "expo": {
    "name": "Hearth",
    "slug": "hearth",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hearth",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.uhearth.mobile",
      "buildNumber": "1",
      "supportsTablet": false,
      "associatedDomains": ["applinks:uhearth.app"],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#b5502f",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "versionCode": 1,
      "predictiveBackGestureEnabled": false,
      "package": "app.uhearth.mobile",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            { "scheme": "https", "host": "uhearth.app", "pathPrefix": "/channels/" },
            { "scheme": "https", "host": "uhearth.app", "pathPrefix": "/clubs/" },
            { "scheme": "https", "host": "uhearth.app", "pathPrefix": "/courses/" },
            { "scheme": "https", "host": "uhearth.app", "pathPrefix": "/events/" },
            { "scheme": "https", "host": "uhearth.app", "pathPrefix": "/messages/" },
            { "scheme": "https", "host": "uhearth.app", "pathPrefix": "/u/" }
          ]
        }
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#b5502f"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Hearth uses your photo library so you can share pictures in chats and set a profile photo.",
          "cameraPermission": "Hearth uses the camera so you can take a photo to share in chats or use as your profile photo."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#faf6ee",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140,
          "dark": {
            "backgroundColor": "#1c1612"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}

# Copy to .env.local and fill in from your Supabase project
# (Project settings → API). Both values are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Server-only — bypasses RLS. Used for Canvas sync writes, schedule-image
# audit logging, and public member counts. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Phone verification (optional trust badge). Leave as "stub" for local dev —
# codes are logged to the server console. Set to "twilio" in production.
PHONE_VERIFY_PROVIDER=stub
# Required only when PHONE_VERIFY_PROVIDER=twilio:
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=
# Escape hatch for previews without Twilio (never enable on a real launch):
# ALLOW_STUB_PHONE_VERIFY=true

# Public origin for absolute URLs in metadata, robots.txt and the sitemap.
# Falls back to https://huddl.app when unset — set it for previews/staging.
# SITE_URL=https://huddl.app

# Copy to .env.local and fill in from your Supabase project
# (Project settings → API). Both values are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Server-only — bypasses RLS. Used for the public channel-member counts on
# the browse page. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public origin for absolute URLs in metadata, robots.txt and the sitemap.
# Falls back to https://huddl.app when unset — set it for previews/staging.
# SITE_URL=https://huddl.app
